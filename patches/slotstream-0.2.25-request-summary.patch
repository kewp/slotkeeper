+/// The one-line record `serve` writes for each finished request. Supervisors parse
+/// it for measured speed, so its shape is checked (`request-summary`).
+public enum RequestSummary {
+    public static func line(_ s: GenStats) -> String {
+        if let failure = s.requestFailure {
+            return String(format: "request: failed (%@) after %.1f s: %@",
+                          "\(failure.code)", s.requestSeconds, failure.message)
+        }
+        let firstToken = s.queueSeconds + s.preparationSeconds + s.prefillSeconds
+        return String(format: "request: done, %d prompt tokens (%d read at %.0f tok/s, %d reused), "
+                      + "%d generated at %.2f tok/s, first token after %.1f s, finish %@",
+                      s.promptTokens, s.prefillTokens, s.prefillTPS, s.reusedPrefixTokens,
+                      s.decodeTokens, s.decodeTPS, firstToken, s.finishReason)
+    }
+}
+
 public struct GenStats: Codable {
     package init() {}
     public var requestSeconds = 0.0
diff -ruN before/Sources/SlotstreamTestKit/OpenAIChecks.swift after/Sources/SlotstreamTestKit/OpenAIChecks.swift
--- a/Sources/SlotstreamTestKit/OpenAIChecks.swift	2026-09-25 03:26:17
+++ b/Sources/SlotstreamTestKit/OpenAIChecks.swift	2026-09-26 19:26:05
@@ -7,7 +7,29 @@
         [Check("openai-conversation", tier: .t0) { try openAIConversation() },
          Check("openai-tool-output", tier: .t0) { try openAIToolOutput() },
          Check("prefill-progress", tier: .t0) { prefillProgress() },
-         Check("openai-context-budget", tier: .t0) { try openAIContextBudget() }]
+         Check("openai-context-budget", tier: .t0) { try openAIContextBudget() },
+         Check("request-summary", tier: .t0) { requestSummary() }]
+    }
+
+    /// The per-request log line supervisors parse for measured speed.
+    static func requestSummary() -> CheckReport {
+        var c = CheckBuilder("request-summary")
+        var s = GenStats()
+        s.promptTokens = 3071; s.prefillTokens = 3071; s.prefillSeconds = 33.0
+        s.decodeTokens = 480; s.decodeSeconds = 41.2; s.queueSeconds = 0.5; s.preparationSeconds = 0.1
+        let done = RequestSummary.line(s)
+        c.expect("a finished request starts with its outcome", done.hasPrefix("request: done, 3071 prompt tokens"))
+        c.expect("it carries measured prefill speed", done.contains("3071 read at 93 tok/s, 0 reused"))
+        c.expect("it carries measured decode speed", done.contains("480 generated at 11.65 tok/s"))
+        c.expect("first token counts queue, preparation and prefill", done.contains("first token after 33.6 s"))
+        c.expect("it ends with the finish reason", done.hasSuffix("finish stop"))
+        var f = GenStats()
+        f.requestFailure = RequestFailure(.insufficientMemory, "memory pressure interrupted inference")
+        f.requestSeconds = 12.0
+        let failed = RequestSummary.line(f)
+        c.expect("a failed request says so with its code and time",
+            failed.hasPrefix("request: failed (") && failed.contains("after 12.0 s: memory pressure interrupted inference"))
+        return c.report()
     }
 
