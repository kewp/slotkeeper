+        var falling = inputs(slots: shed, avail: 2.0, sincePressure: 120, sinceResize: 120)
+        falling.pressureCeilingSlots = shed
+        c.expect("ceiling: never blocks an availability shrink", (slots(P.decide(falling)) ?? shed) < shed,
+            "got \(P.decide(falling))")
+        c.equal("ceiling: first event records the live pool",
