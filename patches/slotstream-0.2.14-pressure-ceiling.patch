+            (slots(capped) ?? Int.max) <= met - oneGB && (slots(capped) ?? 0) > shed, "got \(capped)")
+        c.equal("ceiling: says why", reason(capped), "memory freed, capped below the pool that met pressure")
+        c.equal("ceiling: still waits out the 60 s cooldown", grown(met, since: 30), .hold)
+        c.equal("ceiling: forgotten after pressureMemory", slots(grown(met, since: P.pressureMemory + 1)), slots(baseline))
+        c.equal("ceiling: above the replan has no effect", slots(grown(Geometry.totalRecords, since: 120)), slots(baseline))
+        let near = Geometry.slotsForPoolGB(Geometry.gb(shed) + 2.5)
