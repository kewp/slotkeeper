         c.expect("unavailable budget cannot silently unload a resident head",
             P.desiredPlan(starved) == nil || P.desiredPlan(starved)?.mtpEnabled == true)
 
+        // Pressure ceiling: after an event at `met` slots and a shed, a fully
+        // recovered machine may not regrow past 1 GB below `met` for
+        // pressureMemory, which the plain replan did within 60 s.
+        let oneGB = Int((1e9 / Geometry.recordBytes).rounded(.up))
+        let met = steady
+        let shed = Geometry.slotsForPoolGB(Geometry.gb(steady) - 8)
+        let recovered = steadyAvail + Geometry.gb(steady) - Geometry.gb(shed)
+        func grown(_ ceiling: Int?, since: Double) -> P.Decision {
+            var i = inputs(slots: shed, avail: recovered, sincePressure: since, sinceResize: since)
+            i.pressureCeilingSlots = ceiling
+            return P.decide(i)
+        }
+        let baseline = grown(nil, since: 120)
+        c.expect("fixture: without a ceiling the replan regrows past the pool that met pressure",
+            (slots(baseline) ?? 0) > met - oneGB, "got \(baseline)")
+        let capped = grown(met, since: 120)
