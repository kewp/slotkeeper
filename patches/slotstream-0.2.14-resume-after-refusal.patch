     /// with a pressure interruption both times.
     public static let pressureMemory: TimeInterval = 1200
 
+    /// Whether a shrink should also drop the retained conversations.
+    ///
+    /// Retention used to go first on every shrink, because ~0.9 GB bought back
+    /// one re-prefill of a short turn. At a long window that trade inverts: a
+    /// 48K prefix costs 16 minutes to rebuild (measured 2026-09-11), while the
+    /// expert pool it would protect refills from SSD as requests run. So drop
+    /// it only when little is held, or when the pool is already at the floor
+    /// and there is nothing else left to give.
+    public static let protectedHeldTokens = 8192
+
+    public static func shouldDropRetainedPrefix(heldTokens: Int, targetSlots: Int) -> Bool {
+        heldTokens <= protectedHeldTokens || targetSlots <= Geometry.floorSlots
+    }
+
     /// The ceiling to remember after an event with `live` slots in the pool:
     /// the lower of that and a still-remembered earlier ceiling, so repeated
     /// events ratchet it down rather than resetting it upwards.
