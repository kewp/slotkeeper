diff -ruN a/Sources/Slotstream/RequestControl.swift b/Sources/Slotstream/RequestControl.swift
--- a/Sources/Slotstream/RequestControl.swift	2026-09-11 16:44:16
+++ b/Sources/Slotstream/RequestControl.swift	2026-09-12 00:32:17
@@ -27,6 +27,24 @@
 public struct RequestFailure: Error, CustomStringConvertible, Codable, Sendable, Equatable {
     package static let safeRetryAdvice = "try your request again after memory becomes available"
 
+    /// Whether a prefix committed before this failure may be kept for the retry.
+    ///
+    /// A refusal raised between prefill passes leaves the state exactly on a
+    /// whole-stack boundary, so the tokens already read are still valid; the
+    /// client is told to try again, and re-reading them costs the same minutes
+    /// again (19 minutes of a 56K prefill, measured 2026-09-11). An execution
+    /// error may have mutated early layers, so it keeps nothing. The caller
+    /// must still verify the boundary against the state it holds.
+    public var retainsCommittedPrefix: Bool {
+        switch code {
+        case .insufficientMemory, .prefillWaitExceeded, .prefillDeadlineExceeded, .clientCancelled,
+             .contextLengthExceeded:
+            return true
+        case .inferenceError, .invalidConfiguration:
+            return false
+        }
+    }
+
     public enum Code: String, Codable, Sendable {
         case contextLengthExceeded = "context_length_exceeded"
         case invalidConfiguration = "invalid_configuration"
@@ -173,6 +191,8 @@
     }
     public var failure: RequestFailure? { lock.withLock { failureValue } }
     public var mayRetainState: Bool { failure == nil }
+    /// A committed prefix survives no failure, or one raised at a pass boundary.
+    public var mayRetainCommittedPrefix: Bool { failure?.retainsCommittedPrefix ?? true }
     @discardableResult public func fail(_ error: RequestFailure) -> RequestFailure {
         lock.withLock {
             if failureValue == nil { failureValue = error }
