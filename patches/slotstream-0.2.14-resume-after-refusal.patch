diff -ruN a/Sources/Slotstream/PrefixCache.swift b/Sources/Slotstream/PrefixCache.swift
--- a/Sources/Slotstream/PrefixCache.swift	2026-09-11 16:44:16
+++ b/Sources/Slotstream/PrefixCache.swift	2026-09-12 02:57:34
@@ -541,6 +541,24 @@
 
     /// Release everything held. Used by the governor when memory tightens and
     /// by `--no-prefix-cache`.
+    /// Release every retained conversation except the most recently touched.
+    ///
+    /// A request refused for memory has just published the boundary its prefill
+    /// reached, and that boundary is the most expensive thing on the machine to
+    /// rebuild: 50,176 tokens, 20 minutes of prefill, measured 2026-09-12.
+    /// Dropping everything frees the older conversations, which is what the
+    /// failure needs, while the retry still resumes.
+    @discardableResult
+    public func dropAllButLatest() -> Int {
+        lock.lock()
+        defer { lock.unlock() }
+        guard let keep = entries.indices.max(by: { entries[$0].used < entries[$1].used }) else { return 0 }
+        let dropped = entries.count - 1
+        _evictions += dropped
+        entries = [entries[keep]]
+        return dropped
+    }
+
     public func drop() {
         lock.lock()
         defer { lock.unlock() }
