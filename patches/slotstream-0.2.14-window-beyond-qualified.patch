--- a/Sources/SlotstreamDiagnostics/Diagnostics+Context.swift	2026-09-11 16:44:16
+++ b/Sources/SlotstreamDiagnostics/Diagnostics+Context.swift	2026-09-12 10:42:50
@@ -2,6 +2,34 @@
 import Slotstream
 
 extension Diagnostics {
+    /// Windows above the qualified envelope are a memory question, not a forbidden one.
+    public static func beyondQualifiedContext() -> CheckReport {
+        var c = CheckBuilder("beyond-qualified-context")
+        c.expect("the qualified envelope still refuses a larger window by default",
+            ContextPolicy.validationError(98_304) != nil)
+        c.expect("an explicit qualification admits it",
+            ContextPolicy.validationError(98_304, qualification: true) == nil)
+        c.expect("the model's own limit is still a limit",
+            ContextPolicy.validationError(ContextPolicy.modelLimit + 1, qualification: true) != nil)
+        c.equal("the largest admitted window is the checkpoint's",
+            ContextPolicy.validationError(ContextPolicy.modelLimit, qualification: true), nil)
+        // The planner must price it rather than wave it through: a 98,304 window on a
+        // small machine does not fit, and on a large one it does.
+        let small = try? Planner.plan(expertsPerLayer: nil, poolGB: nil, memoryGB: 11,
+            ramGB: 26, workingSetGB: 19, availableGB: 24, vision: .off,
+            maxContextTokens: 98_304, simulated: true, qualification: true)
+        c.expect("a window that does not fit is refused before loading", small == nil)
+        let large = try? Planner.plan(expertsPerLayer: nil, poolGB: nil, memoryGB: 40,
+            ramGB: 64, workingSetGB: 48, availableGB: 60, vision: .off,
+            maxContextTokens: 98_304, simulated: true, qualification: true)
+        c.expect("the same window fits where the memory is there", large != nil)
+        if let plan = large {
+            c.equal("and it is priced at the window asked for", plan.maxContextTokens, 98_304)
+            c.expect("with the pool paying for it", plan.slots > Geometry.floorSlots)
+        }
+        return c.report()
+    }
+
